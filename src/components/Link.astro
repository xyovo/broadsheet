---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  group?: boolean;
};

const {
  href,
  external,
  underline = true,
  group = false,
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  class={cn(
    "inline-block text-current decoration-[var(--line-strong)] transition-colors duration-200 ease-out hover:text-[var(--text)] hover:decoration-[var(--text)] focus-visible:text-[var(--text)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]",
    underline && "underline underline-offset-[3px]",
    group && "group",
  )}
  {...rest}
>
  <slot />
</a>
