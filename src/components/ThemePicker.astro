---
import { Icon } from "astro-icon/components";

const modes = [
  { value: "light", label: "亮色", icon: "tabler:sun" },
  { value: "dark", label: "暗色", icon: "tabler:moon" },
  { value: "system", label: "跟随系统", icon: "tabler:device-desktop" },
];
---

<div class="theme-picker" data-theme-picker>
  <button
    type="button"
    class="sphere-icon-button"
    data-theme-menu-trigger
    aria-label="主题：跟随系统"
    aria-haspopup="menu"
    aria-expanded="false"
    title="主题：跟随系统"
  >
    <span class="theme-trigger-icon" data-theme-icon="light">
      <Icon name="tabler:sun" size={18} aria-hidden="true" />
    </span>
    <span class="theme-trigger-icon" data-theme-icon="dark">
      <Icon name="tabler:moon" size={18} aria-hidden="true" />
    </span>
    <span class="theme-trigger-icon" data-theme-icon="system">
      <Icon name="tabler:device-desktop" size={18} aria-hidden="true" />
    </span>
  </button>

  <div
    class="theme-menu"
    data-theme-menu
    role="menu"
    aria-label="选择主题"
    aria-hidden="true"
  >
    {
      modes.map((mode) => (
        <button
          type="button"
          class="theme-option"
          data-theme-mode={mode.value}
          role="menuitemradio"
          aria-checked="false"
        >
          <Icon name={mode.icon} size={17} aria-hidden="true" />
          <span>{mode.label}</span>
          <Icon
            name="tabler:check"
            size={16}
            class="theme-option-check"
            aria-hidden="true"
          />
        </button>
      ))
    }
  </div>
</div>
