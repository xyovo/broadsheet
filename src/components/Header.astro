---
import ThemePicker from "@components/ThemePicker.astro";
import { Icon } from "astro-icon/components";
import { NAV_LINKS, SITE } from "@consts";

const { pathname } = Astro.url;
const items = NAV_LINKS;

const isActive = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(`${href}/`);
---

<header id="site-header" class="fixed inset-x-0 top-0 z-40 h-16">
  <div class="site-header-inner">
    <div class="site-nav-shell h-16">
      <div
        class="site-nav-content flex h-full items-center justify-between gap-5"
      >
        <a href="/" class="brand-link" aria-label={`${SITE.TITLE} 首页`}>
          <span class="site-wordmark">{SITE.WORDMARK}</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
          {
            items.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "sphere-nav-link",
                  isActive(item.href) && "is-active",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="ml-auto flex items-center gap-1 sm:gap-2">
          <a
            href="/rss.xml"
            class="sphere-icon-button hidden sm:inline-flex"
            aria-label="RSS 订阅"
            title="RSS 订阅"
          >
            <Icon name="tabler:rss" size={18} aria-hidden="true" />
          </a>
          <button
            type="button"
            class="sphere-icon-button"
            data-search-trigger
            aria-label="打开站内搜索"
            aria-keyshortcuts="/ Control+K Meta+K"
            title="搜索"
          >
            <Icon name="tabler:search" size={18} aria-hidden="true" />
          </button>
          <ThemePicker />

          <button
            id="menu-toggle"
            type="button"
            class="sphere-icon-button md:hidden"
            aria-label="打开导航菜单"
            aria-expanded="false"
            aria-controls="mobile-menu"
            title="菜单"
          >
            <span class="menu-icon menu-icon-open">
              <Icon name="tabler:menu-2" size={19} aria-hidden="true" />
            </span>
            <span class="menu-icon menu-icon-close">
              <Icon name="tabler:x" size={19} aria-hidden="true" />
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu md:hidden" aria-hidden="true">
    <nav class="flex flex-col items-center gap-2" aria-label="移动端导航">
      <a
        href="/"
        data-menu-link
        aria-current={isActive("/") ? "page" : undefined}
        class:list={["sphere-nav-link", isActive("/") && "is-active"]}
      >
        首页
      </a>
      {
        items.map((item) => (
          <a
            href={item.href}
            data-menu-link
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={["sphere-nav-link", isActive(item.href) && "is-active"]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/tags" data-menu-link class="sphere-nav-link">标签</a>
      <a href="/rss.xml" data-menu-link class="sphere-nav-link">RSS</a>
    </nav>
  </div>
</header>

<script is:inline>
  function initializeMobileMenu() {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu || toggle.dataset.ready === "true") return;

    const closeMenu = () => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "打开导航菜单");
      toggle.setAttribute("title", "菜单");
      menu.setAttribute("aria-hidden", "true");
      menu.classList.remove("is-open");
    };

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      toggle.setAttribute("aria-label", open ? "打开导航菜单" : "关闭导航菜单");
      toggle.setAttribute("title", open ? "菜单" : "关闭");
      menu.setAttribute("aria-hidden", String(open));
      menu.classList.toggle("is-open", !open);
    });

    menu.querySelectorAll("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    toggle.dataset.ready = "true";
  }

  initializeMobileMenu();
  document.addEventListener("astro:page-load", initializeMobileMenu);
</script>
