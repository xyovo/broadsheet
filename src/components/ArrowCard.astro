---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import TagLink from "@components/TagLink.astro";
import { readingTime } from "@lib/utils";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  showCover?: boolean;
};

const { entry, showCover = false } = Astro.props as Props;
const tags = entry.collection === "blog" ? (entry.data.tags ?? []) : [];
const duration = entry.body ? readingTime(entry.body) : null;
---

<article
  class:list={[
    "linen-entry not-prose group relative",
    showCover && entry.data.cover && "linen-entry-with-cover",
  ]}
>
  <div class="min-w-0">
    <h3 class="line-clamp-2">
      <a
        href={`/${entry.collection}/${entry.id}`}
        class="linen-entry-link after:absolute after:inset-0"
      >
        {entry.data.title}
      </a>
    </h3>
    {
      tags.length > 0 && (
        <div class="linen-entry-tags relative z-10">
          {tags.map((tag) => (
            <TagLink tag={tag} />
          ))}
        </div>
      )
    }
    <p class="linen-entry-description line-clamp-3">
      {entry.data.description}
    </p>
    <div class="linen-entry-meta">
      <FormattedDate date={entry.data.date} />
      <span>{entry.collection === "blog" ? "文章" : "项目"}</span>
      {duration && <span>{duration}</span>}
    </div>
  </div>
  {
    showCover && entry.data.cover && (
      <a
        class="linen-entry-cover"
        href={`/${entry.collection}/${entry.id}`}
        tabindex="-1"
        aria-hidden="true"
      >
        <img
          src={entry.data.cover}
          alt=""
          width="520"
          height="320"
          loading="lazy"
        />
      </a>
    )
  }
</article>
