---
import { getCollection } from "astro:content";
import TagLink from "@components/TagLink.astro";
import { Icon } from "astro-icon/components";
import { SITE, STACK } from "@consts";

const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagCounts = posts.reduce((counts, post) => {
  post.data.tags.forEach((tag) => counts.set(tag, (counts.get(tag) ?? 0) + 1));
  return counts;
}, new Map<string, number>());

const featuredTags = [...tagCounts.entries()]
  .sort(([tagA, countA], [tagB, countB]) =>
    countB === countA ? tagA.localeCompare(tagB, SITE.LOCALE) : countB - countA,
  )
  .slice(0, 8);

const author = SITE.AUTHOR;
---

<aside class="reference-sidebar animate" aria-label={`关于 ${author.NAME}`}>
  <div class="author-card">
    <div class="author-heading">
      <span class="author-avatar" aria-hidden="true">{author.INITIALS}</span>
      <div>
        <h2>{author.NAME}</h2>
        <p>{author.ROLE}</p>
      </div>
    </div>
    <p class="author-slogan">{author.SLOGAN}</p>
    <div class="author-stats">
      <a href="/blog"><strong>{posts.length}</strong> 文章</a>
      <a href="/projects"><strong>{projects.length}</strong> 项目</a>
      <a href="/tags"><strong>{tagCounts.size}</strong> 标签</a>
    </div>
  </div>

  {
    featuredTags.length > 0 && (
      <section class="sidebar-block">
        <div class="sidebar-block-title">
          <h3>标签</h3>
          <a href="/tags">全部</a>
        </div>
        <div class="reference-tags">
          {featuredTags.map(([tag, count]) => (
            <TagLink tag={tag} count={count} />
          ))}
        </div>
      </section>
    )
  }

  {
    STACK.length > 0 && (
      <section class="sidebar-block">
        <h3>常用技术</h3>
        <p class="sidebar-inline-list">{STACK.join(" / ")}</p>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section class="sidebar-block">
        <div class="sidebar-block-title">
          <h3>最近项目</h3>
          <a href="/projects">全部</a>
        </div>
        <ul class="sidebar-project-list">
          {projects.slice(0, 3).map((project) => (
            <li>
              <a href={`/projects/${project.id}`}>
                <span>{project.data.title}</span>
                <Icon
                  name="tabler:arrow-up-right"
                  size={16}
                  aria-hidden="true"
                />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</aside>
