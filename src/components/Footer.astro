---
import Container from "@components/Container.astro";
import { Icon } from "astro-icon/components";
import { FOOTER_LINKS, SITE } from "@consts";
---

<footer class="site-footer">
  <Container wide>
    <div class="reference-footer">
      <div>
        <a href="/" class="site-wordmark">{SITE.WORDMARK}</a>
        <p>{SITE.TAGLINE}</p>
      </div>

      <nav aria-label="页脚导航">
        {
          FOOTER_LINKS.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith("/rss") ? "_blank" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="reference-footer-meta">
        <span>&copy; {new Date().getFullYear()} {SITE.AUTHOR.NAME}</span>
        <button id="back-to-top" type="button">
          <span>返回顶部</span>
          <Icon name="tabler:arrow-up" size={15} aria-hidden="true" />
        </button>
      </div>
    </div>
  </Container>
</footer>
