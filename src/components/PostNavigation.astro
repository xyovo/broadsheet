---
import { Icon } from "astro-icon/components";

const { prevPost, nextPost } = Astro.props;
---

<nav class="post-navigation grid gap-3 sm:grid-cols-2" aria-label="文章翻页">
  {
    prevPost?.id ? (
      <a
        href={`/blog/${prevPost.id}`}
        class="post-navigation-link not-prose group text-left"
      >
        <Icon
          name="tabler:arrow-left"
          size={20}
          class="text-[var(--accent)] transition-transform group-hover:-translate-x-1"
          aria-hidden="true"
        />
        <span class="min-w-0">
          <span class="block font-mono text-xs text-[var(--muted)]">
            上一篇
          </span>
          <span class="mt-1 block truncate text-sm font-medium text-[var(--text)]">
            {prevPost.data.title}
          </span>
        </span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )
  }
  {
    nextPost?.id ? (
      <a
        href={`/blog/${nextPost.id}`}
        class="post-navigation-link not-prose group text-right sm:col-start-2"
      >
        <span class="min-w-0 flex-1">
          <span class="block font-mono text-xs text-[var(--muted)]">
            下一篇
          </span>
          <span class="mt-1 block truncate text-sm font-medium text-[var(--text)]">
            {nextPost.data.title}
          </span>
        </span>
        <Icon
          name="tabler:arrow-right"
          size={20}
          class="text-[var(--accent)] transition-transform group-hover:translate-x-1"
          aria-hidden="true"
        />
      </a>
    ) : null
  }
</nav>
