---
import Search from "astro-pagefind/components/Search";
---

<aside data-pagefind-ignore>
  <div
    id="backdrop"
    class="invisible fixed inset-0 z-50 flex min-h-[100dvh] justify-center bg-slate-950/45 p-4 pt-24 opacity-0 transition-[opacity,visibility] duration-200 sm:p-6 sm:pt-28"
    aria-hidden="true"
  >
    <div
      id="pagefind-container"
      role="dialog"
      aria-modal="true"
      aria-label="站内搜索"
      class="search-panel h-fit max-h-[76dvh] w-full max-w-xl overflow-auto p-4 sm:p-5"
    >
      <Search
        id="search"
        className="pagefind-ui"
        uiOptions={{
          showImages: false,
          excerptLength: 15,
          resetStyles: false,
          translations: {
            placeholder: "搜索文章和项目…",
            clear_search: "清除",
            load_more: "加载更多",
            search_label: "站内搜索",
            filters_label: "筛选",
            zero_results: "没有找到与“[SEARCH_TERM]”相关的内容",
            one_result: "找到 1 条与“[SEARCH_TERM]”相关的内容",
            many_results: "找到 [COUNT] 条与“[SEARCH_TERM]”相关的内容",
            searching: "正在搜索“[SEARCH_TERM]”…",
          },
        }}
      />
      <p class="mt-4 text-right text-xs text-[var(--muted)]">
        按 Esc 或点击空白处关闭
      </p>
    </div>
  </div>
</aside>

<script is:inline>
  function initializePagefindDialog() {
    const backdrop = document.getElementById("backdrop");
    if (!backdrop || backdrop.dataset.ready === "true") return;

    const openPagefind = () => {
      backdrop.classList.remove("invisible", "opacity-0");
      backdrop.classList.add("visible", "opacity-100");
      backdrop.setAttribute("aria-hidden", "false");
      window.setTimeout(() => {
        backdrop.querySelector("input")?.focus();
      }, 0);
    };

    const closePagefind = () => {
      backdrop.classList.remove("visible", "opacity-100");
      backdrop.classList.add("invisible", "opacity-0");
      backdrop.setAttribute("aria-hidden", "true");
    };

    document.querySelectorAll("[data-search-trigger]").forEach((trigger) => {
      if (trigger.dataset.searchReady === "true") return;
      trigger.addEventListener("click", openPagefind);
      trigger.dataset.searchReady = "true";
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closePagefind();
      if (
        event.key === "/" ||
        ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k")
      ) {
        const target = event.target;
        if (target?.matches?.("input, textarea, [contenteditable='true']"))
          return;
        event.preventDefault();
        openPagefind();
      }
    });

    backdrop.addEventListener("click", (event) => {
      if (!event.target.closest("#pagefind-container")) closePagefind();
      if (event.target.classList.contains("pagefind-ui__result-link"))
        closePagefind();
    });

    backdrop.dataset.ready = "true";
  }

  initializePagefindDialog();
  document.addEventListener("astro:page-load", initializePagefindDialog);
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.82;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 16px;
    --pagefind-ui-font: "Geist Sans", sans-serif;
    --pagefind-ui-primary: var(--text);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--surface-muted);
  }

  #search input,
  #search p {
    font-weight: 400;
  }

  #search .pagefind-ui__result-title {
    font-weight: 600;
  }

  #search .pagefind-ui__message {
    padding: 0 0 0.75rem;
  }
</style>
