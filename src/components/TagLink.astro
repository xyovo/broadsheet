---
import { tagPath } from "@lib/utils";

type Props = {
  tag: string;
  count?: number;
  active?: boolean;
};

const { tag, count, active = false } = Astro.props;
---

<a
  href={tagPath(tag)}
  class:list={["sphere-tag-link", active && "is-active"]}
  aria-current={active ? "page" : undefined}
>
  <span aria-hidden="true">#</span>
  <span>{tag}</span>
  {typeof count === "number" && <span class="tag-count">{count}</span>}
</a>
