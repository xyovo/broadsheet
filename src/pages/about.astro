---
// 这是一个示例页面：正文、封面图和技术分类都请替换成你自己的内容。
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { Icon } from "astro-icon/components";
import { ABOUT, SITE } from "@consts";

const author = SITE.AUTHOR;

const skills = [
  { label: "前端", items: "Astro、React、TypeScript" },
  { label: "样式", items: "Tailwind CSS、设计系统" },
  { label: "服务端", items: "Node.js、数据库" },
  { label: "工程化", items: "CI/CD、自动化与质量保障" },
];
---

<Layout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <div class="about-page">
    <Container wide>
      <figure class="about-cover animate">
        <img
          src="https://picsum.photos/id/1018/1800/760"
          alt="站点封面占位图"
          width="1800"
          height="760"
          loading="eager"
        />
      </figure>

      <div class="about-layout">
        <aside class="about-index" aria-label="关于页目录">
          <span>{author.NAME}</span>
          <nav>
            <a href="#intro">自我介绍</a>
            <a href="#work">我在做什么</a>
            <a href="#skills">常用技术</a>
          </nav>
        </aside>

        <article class="about-article animate">
          <section id="intro">
            <h1>你好，我是 {author.NAME}。</h1>
            <p>
              这里是一段自我介绍的占位文字。可以写你的职业方向、关注的技术领域，以及开这个博客的原因。建议控制在两三段以内，让读者快速了解你。
            </p>
            <p>
              这个页面基于 Broadsheet 模板，你可以在 <code
                >src/pages/about.astro</code
              > 中自由修改结构与文案。
            </p>
          </section>

          <section id="work">
            <h2>我在做什么</h2>
            <p>
              介绍你日常的工作内容、正在推进的方向，或者近期在学习的东西。如果有公开的作品或开源项目，可以在这里引导读者去项目页面。
            </p>
          </section>

          <section id="skills">
            <h2>常用技术</h2>
            <div class="about-skill-grid not-prose">
              {
                skills.map((skill) => (
                  <div>
                    <strong>{skill.label}</strong>
                    <span>{skill.items}</span>
                  </div>
                ))
              }
            </div>
          </section>

          <a class="about-contact not-prose" href="/projects">
            <span>查看公开项目</span>
            <Icon name="tabler:arrow-up-right" size={18} aria-hidden="true" />
          </a>
        </article>
      </div>
    </Container>
  </div>
</Layout>
