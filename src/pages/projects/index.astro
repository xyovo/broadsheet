---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { PROJECTS } from "@consts";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <div class="project-index-page">
    <Container wide>
      <header class="archive-header animate" data-pagefind-ignore>
        <h1>项目</h1>
        <p>公开展示的个人实验、工程实践与持续维护内容。</p>
        <span>共 {projects.length} 个</span>
      </header>

      {
        projects.length > 0 ? (
          <div class="project-feature-list">
            {projects.map((project) => (
              <article class="project-feature animate">
                <a
                  class="project-feature-image"
                  href={`/projects/${project.id}`}
                  aria-label={`查看项目 ${project.data.title}`}
                >
                  {project.data.cover ? (
                    <img
                      src={project.data.cover}
                      alt=""
                      width="1200"
                      height="800"
                      loading="lazy"
                    />
                  ) : (
                    <span class="project-cover-placeholder" aria-hidden="true">
                      <small>{project.data.status ?? "个人项目"}</small>
                      <strong>{project.data.title.split("·")[0].trim()}</strong>
                      <em>
                        {project.data.title.split("·")[1]?.trim() ?? "Project"}
                      </em>
                    </span>
                  )}
                </a>
                <div class="project-feature-copy">
                  <div class="project-feature-meta">
                    <FormattedDate date={project.data.date} />
                    {project.data.status && <span>{project.data.status}</span>}
                  </div>
                  <h2>
                    <a href={`/projects/${project.id}`}>{project.data.title}</a>
                  </h2>
                  <p>{project.data.description}</p>
                  {project.data.tags.length > 0 && (
                    <ul class="project-tech-list" aria-label="项目技术栈">
                      {project.data.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                  <a
                    class="project-feature-link"
                    href={`/projects/${project.id}`}
                  >
                    查看项目
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="reference-empty animate">还没有发布项目。</div>
        )
      }
    </Container>
  </div>
</Layout>
