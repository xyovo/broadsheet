---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import AuthorSidebar from "@components/AuthorSidebar.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { HOME } from "@consts";
import { readingTime } from "@lib/utils";

const allPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredPost = allPosts[0];
const highlightedPosts = allPosts.slice(1, 4);
const latestPosts = allPosts.slice(4, 10);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <div class="reference-home">
    <Container wide>
      {
        featuredPost ? (
          <section class="lead-story animate" aria-label="推荐文章">
            <a
              class="lead-story-image"
              href={`/blog/${featuredPost.id}`}
              aria-label={`阅读 ${featuredPost.data.title}`}
            >
              {featuredPost.data.cover ? (
                <img
                  src={featuredPost.data.cover}
                  alt=""
                  width="1400"
                  height="900"
                  loading="eager"
                  fetchpriority="high"
                />
              ) : (
                <span class="image-placeholder">文章封面</span>
              )}
            </a>

            <div class="lead-story-copy">
              <p class="lead-story-kicker">最新发布</p>
              <h1>
                <a href={`/blog/${featuredPost.id}`}>
                  {featuredPost.data.title}
                </a>
              </h1>
              <p>{featuredPost.data.description}</p>
              <div class="reference-meta">
                <FormattedDate date={featuredPost.data.date} />
                <span>{featuredPost.data.tags[0] ?? "随笔"}</span>
                <span>{readingTime(featuredPost.body ?? "")}</span>
              </div>
            </div>
          </section>
        ) : (
          <section class="reference-empty">还没有发布文章。</section>
        )
      }

      {
        highlightedPosts.length > 0 && (
          <section
            class="home-highlights animate"
            aria-labelledby="highlights-title"
          >
            <div class="reference-section-title">
              <h2 id="highlights-title">近期文章</h2>
              <a href="/blog">文章归档</a>
            </div>

            <div class="home-highlight-grid">
              {highlightedPosts.map((post, index) => (
                <article
                  class:list={[
                    "home-highlight-card",
                    index === 0 && "home-highlight-card-primary",
                  ]}
                >
                  <a
                    class="home-highlight-image"
                    href={`/blog/${post.id}`}
                    aria-label={`阅读 ${post.data.title}`}
                  >
                    {post.data.cover ? (
                      <img
                        src={post.data.cover}
                        alt=""
                        width="960"
                        height="640"
                        loading="lazy"
                      />
                    ) : (
                      <span class="image-placeholder">文章封面</span>
                    )}
                  </a>

                  <div class="home-highlight-copy">
                    <div class="home-highlight-meta">
                      <FormattedDate date={post.data.date} />
                      <span>{post.data.tags[0] ?? "随笔"}</span>
                    </div>
                    <h3>
                      <a href={`/blog/${post.id}`}>{post.data.title}</a>
                    </h3>
                    <p>{post.data.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }

      <div class="reference-content-grid">
        <section class="reference-posts animate" aria-labelledby="latest-title">
          <div class="reference-section-title">
            <h2 id="latest-title">更多文章</h2>
            <a href="/blog">查看全部</a>
          </div>

          {
            latestPosts.length > 0 ? (
              <ul class="reference-post-list">
                {latestPosts.map((post) => (
                  <li>
                    <ArrowCard entry={post} showCover />
                  </li>
                ))}
              </ul>
            ) : (
              <div class="reference-empty">还没有发布文章。</div>
            )
          }
        </section>

        <AuthorSidebar />
      </div>
    </Container>
  </div>
</Layout>
